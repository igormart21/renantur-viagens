# Supabase — copie para .env.local e preencha com as credenciais do seu projeto
# (Project Settings > API no painel do Supabase). NÃO comite o .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Usada apenas no servidor (server actions / rotas admin). Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
